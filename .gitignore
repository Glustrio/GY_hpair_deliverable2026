# Dependencies are installed from package-lock.json, so they do not belong in git.
# Committing them also corrupts the .bin symlinks, which breaks the build on a fresh clone.
node_modules/

# Build output is generated by `npm run build`.
build/

# Local secrets and machine-specific config.
.env
.env.local
.env.*.local

# OS and editor noise.
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# Gordon's private interview-prep notes. Not part of the submission.
NOTES_FOR_GORDON.md
docs/notes/
